{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wiki-golf",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,

  // Built front end, served as Workers Static Assets with SPA fallback.
  // The Worker runs first only for /api/*.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wiki-golf",
      "database_id": "4fd16e0f-2c71-4fda-8d92-e07f03bbfd44",
      "migrations_dir": "migrations",
    },
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "wiki-golf",
    },
  ],

  "vars": {
    "WIKI": "simplewiki",
    "ENVIRONMENT": "dev",
  },

  "observability": { "enabled": true },
}
